# Examples only. Never commit the real .env file or credentials.
DATABASE_PASSWORD=replace-with-a-local-database-password
# For local PostgreSQL: use local,postgres profiles to retain localhost-only mail preview.
# SPRING_PROFILES_ACTIVE=local,postgres
# DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/assessment
# DATABASE_USERNAME=assessment
# Production (provide through the hosting environment, not this file):
# SPRING_PROFILES_ACTIVE=prod
# DATABASE_URL=jdbc:postgresql://YOUR_RDS_HOST:5432/assessment?sslmode=verify-full&sslrootcert=/path/to/global-bundle.pem
# DATABASE_USERNAME=assessment_app
# APP_BASE_URL=https://your-domain.example
# SMTP_HOST=email-smtp.YOUR_REGION.amazonaws.com
# SMTP_PORT=587
# SMTP_USERNAME=your-smtp-username
# SMTP_PASSWORD=your-smtp-password
# MAIL_FROM=verified-sender@your-domain.example
